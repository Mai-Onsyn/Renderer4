# 天空盒 OBJ，左手坐标系，中心在原点，边长 128
mtllib skybox.mtl

# ---- 顶点坐标 (v) ----
# 前表面 (+Z)
v -64 64 64
v -64 -64 64
v 64 -64 64
v 64 64 64
# 后表面 (-Z)
v -64 64 -64
v -64 -64 -64
v 64 -64 -64
v 64 64 -64
# 上表面 (+Y)
v -64 64 64
v 64 64 64
v 64 64 -64
v -64 64 -64
# 下表面 (-Y)
v -64 -64 64
v -64 -64 -64
v 64 -64 -64
v 64 -64 64
# 左表面 (-X)
v -64 64 64
v -64 64 -64
v -64 -64 -64
v -64 -64 64
# 右表面 (+X)
v 64 64 64
v 64 -64 64
v 64 -64 -64
v 64 64 -64

# ---- 纹理坐标 (vt) ----
# 前表面（未翻转）
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
# 后表面（水平翻转，模拟代码中 p2->flipHorizontally()）
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.0 0.0
# 上表面（垂直翻转，模拟代码中 p4->flipVertically()）
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0
# 下表面（未翻转）
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
# 左表面（水平翻转，模拟代码中 p3->flipHorizontally()）
vt 1.0 0.0
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
# 右表面（未翻转）
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0

# ---- 面定义（每个面两个三角形） ----
# 前表面 (+Z)
usemtl sky_front
f 1/1 3/3 2/2
f 1/1 4/4 3/3

# 后表面 (-Z)
usemtl sky_back
f 5/5 6/6 7/7
f 5/5 7/7 8/8

# 上表面 (+Y)
usemtl sky_top
f 9/9 11/11 10/10
f 9/9 12/12 11/11

# 下表面 (-Y)
usemtl sky_bottom
f 13/13 15/15 14/14
f 13/13 16/16 15/15

# 左表面 (-X)
usemtl sky_left
f 17/17 19/19 18/18
f 17/17 20/20 19/19

# 右表面 (+X)
usemtl sky_right
f 21/21 23/23 22/22
f 21/21 24/24 23/23